#!/bin/bash -l
#$ -P ds598ns
#$ -l gpus=2
#$ -l gpu_c=7.0
#$ -l h_rt=02:00:00
#$ -l mem_free=32G
#$ -pe smp 8
#$ -j y
#$ -o logs/sge/
#$ -N cmnist_p1
# Colored-MNIST Phase 1, one seed per GPU. Submit: qsub jobs/cmnist_phase1.qsub
# (resubmit to resume; SEEDS via qsub -v SEEDS="0 1")

cd /projectnb/ds598ns/projects/Team2project
module load python3/3.12.4
source env/bin/activate
set -euo pipefail
umask 022
nvidia-smi -L
# Use the GPUs the scheduler assigned (CUDA_VISIBLE_DEVICES, e.g. "2,3"); default 0,1.
IFS=, read -r -a GPUS <<< "${CUDA_VISIBLE_DEVICES:-0,1}"
echo "assigned GPUs: ${GPUS[*]}"

SEEDS=${SEEDS:-"0 1"}
read -r -a SEED_ARR <<< "$SEEDS"
pids=()
i=0
for s in "${SEED_ARR[@]}"; do
  CUDA_VISIBLE_DEVICES=${GPUS[$i]} python -m plasticity.train --config configs/cmnist_phase1.json \
      --seed "$s" --num-workers 3 &
  pids+=($!)
  i=$((i + 1))
done
status=0
for p in "${pids[@]}"; do wait "$p" || status=$?; done
if [ "$status" -ne 0 ]; then echo "a run failed (exit $status)"; exit "$status"; fi
