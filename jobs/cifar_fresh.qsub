#!/bin/bash -l
#$ -P ds598ns
#$ -l gpus=2
#$ -l gpu_c=7.0
#$ -l h_rt=02:00:00
#$ -l mem_free=32G
#$ -pe smp 8
#$ -j y
#$ -o logs/sge/
#$ -N cifar_fresh
# Run 1: CIFAR-10 fresh training, one seed per GPU.
# Submit: qsub -v SEEDS="0 1",SCHEDULE=dense jobs/cifar_fresh.qsub   (resubmit to resume)

cd /projectnb/ds598ns/projects/Team2project
module load python3/3.12.4
source env/bin/activate
set -euo pipefail
umask 022
export OMP_NUM_THREADS=4   # two runs share the 8 requested cores
nvidia-smi -L
# Use the GPUs the scheduler assigned (CUDA_VISIBLE_DEVICES, e.g. "2,3"); default 0,1.
IFS=, read -r -a GPUS <<< "${CUDA_VISIBLE_DEVICES:-0,1}"
echo "assigned GPUs: ${GPUS[*]}"

SEEDS=${SEEDS:-"0 1"}
SCHEDULE=${SCHEDULE:-dense}
read -r -a SEED_ARR <<< "$SEEDS"
if [ "${#SEED_ARR[@]}" -gt "${#GPUS[@]}" ]; then
  echo "need ${#SEED_ARR[@]} GPUs but only ${#GPUS[@]} assigned (${GPUS[*]}); reduce the list" >&2
  exit 2
fi
source jobs/wait_all.sh   # wait_all: collect every run's status, stop siblings on failure
pids=()
i=0
for s in "${SEED_ARR[@]}"; do
  CUDA_VISIBLE_DEVICES=${GPUS[$i]} python -m plasticity.train --config configs/cifar_fresh.json \
      --seed "$s" --save-schedule "$SCHEDULE" --num-workers 3 &
  pids+=($!)
  i=$((i + 1))
done
wait_all
python -m plasticity.plot --root . --experiment cifar_fresh || true
