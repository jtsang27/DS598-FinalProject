#!/bin/bash -l
#$ -P ds598ns
#$ -l gpus=2
#$ -l gpu_c=7.0
#$ -l h_rt=02:00:00
#$ -l mem_free=32G
#$ -pe smp 8
#$ -j y
#$ -o logs/sge/
#$ -N cmnist_p2
#$ -t 1-3
# Colored-MNIST Phase 2 array job: task i runs two branches side by side.
# One seed per submission. Submit: qsub -hold_jid cmnist_p1 jobs/cmnist_phase2.qsub  (seed 0)
#   then qsub -hold_jid cmnist_p1 -v SEED=1 jobs/cmnist_phase2.qsub; later seeds: -v SEED=k,SCHEDULE=sparse

cd /projectnb/ds598ns/projects/Team2project
module load python3/3.12.4
source env/bin/activate
set -euo pipefail
umask 022
export OMP_NUM_THREADS=4   # two runs share the 8 requested cores
nvidia-smi -L
# Use the GPUs the scheduler assigned (CUDA_VISIBLE_DEVICES, e.g. "2,3"); default 0,1.
IFS=, read -r -a GPUS <<< "${CUDA_VISIBLE_DEVICES:-0,1}"
echo "assigned GPUs: ${GPUS[*]}"

SEED=${SEED:-0}
SCHEDULE=${SCHEDULE:-dense}
PAIRS=("0 1" "2 4" "8 16")
read -r -a NS <<< "${PAIRS[$((SGE_TASK_ID - 1))]}"
if [ "${#NS[@]}" -gt "${#GPUS[@]}" ]; then
  echo "need ${#NS[@]} GPUs but only ${#GPUS[@]} assigned (${GPUS[*]}); reduce the list" >&2
  exit 2
fi
source jobs/wait_all.sh   # wait_all: collect every run's status, stop siblings on failure
pids=()
i=0
for n in "${NS[@]}"; do
  CUDA_VISIBLE_DEVICES=${GPUS[$i]} python -m plasticity.train --config configs/cmnist_phase2.json \
      --seed "$SEED" --branch-n "$n" --save-schedule "$SCHEDULE" --num-workers 3 &
  pids+=($!)
  i=$((i + 1))
done
wait_all
# Plots read every Phase-2 log; the last array task to finish has them all (earlier ones plot partial data).
python -m plasticity.plot --root . --experiment cmnist || true
