#!/bin/bash -l
#$ -P ds598ns
#$ -l gpus=2
#$ -l gpu_c=7.0
#$ -l h_rt=00:30:00
#$ -l mem_free=32G
#$ -pe smp 8
#$ -j y
#$ -o logs/sge/
#$ -N smoke
# Smoke test: pytest, then short runs of every experiment on node-local scratch.
# Submit: mkdir -p logs/sge && qsub jobs/smoke.qsub

cd /projectnb/ds598ns/projects/Team2project
module load python3/3.12.4
source env/bin/activate
set -euo pipefail
umask 022
export OMP_NUM_THREADS=4   # two runs share the 8 requested cores
nvidia-smi -L
# Use the GPUs the scheduler assigned (CUDA_VISIBLE_DEVICES, e.g. "2,3"); default 0,1.
IFS=, read -r -a GPUS <<< "${CUDA_VISIBLE_DEVICES:-0,1}"
echo "assigned GPUs: ${GPUS[*]}"
if [ "${#GPUS[@]}" -lt 2 ]; then echo "smoke needs 2 GPUs, got ${GPUS[*]}" >&2; exit 2; fi

ROOT=/scratch/$USER/smoke
rm -rf "$ROOT"; mkdir -p "$ROOT/data"
# Reuse datasets already downloaded into the project (the CIFAR-10 server is slow, ~100 KB/s).
cp -a data/cifar-10-batches-py data/MNIST "$ROOT/data/" 2>/dev/null || echo "no cached datasets; will download"

python -m pytest -q

# GPU 0: CIFAR-10 fresh run, 200 steps.
CUDA_VISIBLE_DEVICES=${GPUS[0]} python -m plasticity.train --config configs/cifar_fresh.json \
    --root "$ROOT" --seed 0 --total-steps 200 --eval-size 1000 --num-workers 3 &
pid0=$!

# GPU 1: Colored-MNIST Phase 1 (1 epoch), then Phase 2 branching at N = 0 and N = 1.
(
  export CUDA_VISIBLE_DEVICES=${GPUS[1]}
  python -m plasticity.train --config configs/cmnist_phase1.json --root "$ROOT" --seed 0 \
      --phase1-epochs 1 --durations 0 1 --eval-size 1000 --num-workers 3
  for n in 0 1; do
    python -m plasticity.train --config configs/cmnist_phase2.json --root "$ROOT" --seed 0 \
        --branch-n $n --phase1-epochs 1 --phase2-epochs 1 --durations 0 1 \
        --eval-size 1000 --num-workers 3
  done
) &
pid1=$!

source jobs/wait_all.sh   # wait_all: collect every run's status, stop siblings on failure
pids=("$pid0" "$pid1")
wait_all

python -m plasticity.plot --root "$ROOT" --experiment cifar_fresh
python -m plasticity.plot --root "$ROOT" --experiment cmnist
echo "== figures"; ls -R "$ROOT/figures"
for f in "$ROOT"/logs/*/*/metrics.csv; do echo "== $f"; tail -n 3 "$f"; done
echo "SMOKE OK"
